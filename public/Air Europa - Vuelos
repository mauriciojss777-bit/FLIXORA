body > app > .spinner-container > .spinner { animation: 1s linear 0s infinite normal none running spin; border-width: 3px; border-style: solid; border-color: rgb(221, 221, 221) rgb(45, 105, 225) rgb(45, 105, 225); border-image: initial; border-radius: 50%; height: 80px; width: 80px; opacity: 0.8; }

