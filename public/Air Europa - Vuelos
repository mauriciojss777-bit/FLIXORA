.ux-banner-wrapper { margin: 1rem 0px; background-color: rgb(252, 252, 253); border-left: 3px solid rgb(15, 35, 103); display: flex; flex-direction: row; align-items: center; height: 110px; overflow: hidden; box-shadow: rgba(10, 13, 18, 0.1) 0px 4px 6px -1px, rgba(10, 13, 18, 0.06) 0px 2px 4px -2px; }

.ux-banner { display: flex; flex-direction: row; padding: 0px 40px; overflow: hidden; max-height: 100px; }

.ux-banner img { height: 95px; }

.ux-banner-content { display: flex; flex-direction: column; align-items: start; justify-content: center; padding: 3rem; gap: 8px; }

.ux-banner-content h3 { margin: 0px 0px 0.5rem; font-size: 18px; color: rgb(15, 35, 103); font-family: "AE Radar", Lato; text-transform: uppercase; }

.ux-banner-content p { margin: 0px; font-size: 14px; color: rgb(0, 0, 0); font-family: Lato; }

@media (max-width: 700px) {
  .ux-banner-wrapper { margin: 12px 0px; padding: 14px 0px; height: auto; }
  .ux-banner { padding: 0px 14px; overflow: auto; }
  .ux-banner img { display: none; }
  .ux-banner-content { max-width: 100%; padding: 2rem; margin: 0px; gap: 0px; }
}
